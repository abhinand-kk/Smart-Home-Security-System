# =============================================================================
# SmartGuard IoT Motion Monitoring System — Environment Variables Configuration
# =============================================================================

# Flask Secret Key
SECRET_KEY=smartguard-secret-key-college-2026

# ESP32 Device Authentication Key (Keep this secret; must match firmware)
ESP32_API_KEY=smartguard-esp32-secret-key-2026

# Heartbeat Timeout in Seconds (marks device offline if no pings received)
HEARTBEAT_TIMEOUT_SECONDS=45

# Allowed CORS Origins (comma-separated or * for development)
CORS_ORIGINS=*

# PostgreSQL Database Configuration (used by Docker Compose)
POSTGRES_USER=smartuser
POSTGRES_PASSWORD=smartpassword2026
POSTGRES_DB=smartguard_db

# Optional direct DATABASE_URL override. If omitted outside Docker, falls back to SQLite.
# DATABASE_URL=postgresql://smartuser:smartpassword2026@localhost:5432/smartguard_db
